# retrobot-raymond backup repo — deny-by-default, allowlist safe paths only.
# NEVER remove the leading "/*" deny-all rule below.

# 1. Ignore everything by default
/*

# 2. Un-ignore top-level items we want to walk into
!/memories/
!/skills/
!/workspace/
!/cron/
!/SOUL.md
!/profile.yaml
!/assets/
!/.gitignore

# 3. Within skills/, deny everything by default and allowlist ONLY
#    janus (custom trading skill) and agent-authored/patched skills whose
#    content cannot be regenerated by `hermes skills install` from the hub.
skills/*
skills/*/*
skills/*/*/*
!/skills/janus/
!/skills/janus/**
!/skills/productivity/
!/skills/productivity/rec-tracker/
!/skills/productivity/rec-tracker/**
!/skills/productivity/google-api-troubleshooting/
!/skills/productivity/google-api-troubleshooting/**
!/skills/productivity/aesthetic-slide-decks/
!/skills/productivity/aesthetic-slide-decks/**
!/skills/software-development/
!/skills/software-development/browser-exec-headless-setup/
!/skills/software-development/browser-exec-headless-setup/**
!/skills/research/
!/skills/research/situational-safety-monitoring/
!/skills/research/situational-safety-monitoring/**

# 4. Within cron/, only the jobs definition file — never DBs/locks/heartbeats
cron/*
!cron/jobs.json

# 5. Within workspace/, everything (janus reports live here)
# (already un-ignored above; explicit rule for clarity)
!workspace/**

# 6. Lock files, caches, and temp files within allowed directories
memories/*.lock
skills/**/__pycache__/
skills/**/*.pyc
skills/.curator_backups/
skills/.curator_ledger.jsonl
skills/.curator_state
skills/.usage.json
skills/.usage.json.lock
skills/.bundled_manifest
skills/.hub/
workspace/**/*.tmp

# 7. Explicit belt-and-suspenders excludes for known-secret files,
#    in case they ever land inside an allowed directory by mistake.
**/.env
**/*.env
**/google_client_secret.json
**/google_token.json
**/auth.json
**/config.yaml
**/config.yaml.bak.*
**/*password*
**/*secret*
**/*token*
**/*.pem
**/*.key
**/id_rsa*
**/.git-credentials
